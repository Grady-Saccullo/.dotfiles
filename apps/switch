#!/bin/bash -e

echo "$@"

if [[ $# == 0 ]]; then
	echo "missing config name, usage switch <config name> [--local] <optional other args>"
	exit 1
fi

config_name="$1"
shift

# A new machine's first switch runs before its nix.conf enables flakes.
export NIX_CONFIG="${NIX_CONFIG:+$NIX_CONFIG
}extra-experimental-features = nix-command flakes"

if [[ "${1:-}" == "--local" ]]; then
	shift
	DOTFILES_LOCAL="${DOTFILES_LOCAL:-$HOME/.dotfiles}"
fi

# `--local`: swap the `dotfiles` input for that checkout, resolved to a store path once as the user
# so root never runs git in a user-owned repo (README "Changing the framework").
override=()
if [[ -n "${DOTFILES_LOCAL:-}" ]]; then
	if jq -e '.nodes[.root].inputs.dotfiles' flake.lock >/dev/null 2>&1; then
		local_src=$(nix flake metadata --json "git+file://$DOTFILES_LOCAL" | jq -r .path)
		# Run the snapshot's own switch, so an older locked one never reads the local modules' plan.
		if [[ -f "$local_src/apps/switch" && "$0" != "$local_src/apps/switch" && -z "${DOTFILES_SWITCH_REEXEC:-}" ]]; then
			echo "switching to the local framework's switch: $local_src/apps/switch"
			export DOTFILES_LOCAL DOTFILES_SWITCH_REEXEC=1
			exec /bin/bash -e "$local_src/apps/switch" "$config_name" "$@"
		fi
		echo "using local framework: $DOTFILES_LOCAL -> $local_src"
		override=(--override-input dotfiles "path:$local_src")
	else
		echo "--local ignored: this flake has no 'dotfiles' input" >&2
	fi
fi

case $(uname -o) in
Darwin)
	kind=darwin
	;;
Linux)
	if [ ! -f /etc/NIXOS ]; then
		echo "Need to implement/port over linux"
		exit 1
	fi
	kind=nixos
	;;
*)
	echo "System type $(uname -o) not supported"
	exit 1
	;;
esac
host_attr="${kind}Configurations.$config_name"

# build <installable> [extra nix flags...]
function build() {
	local attr="$1"
	shift
	nix build \
		--extra-experimental-features 'nix-command flakes' \
		--show-trace \
		"$@" \
		".#$attr"
}

interactive=false
if [[ -t 0 && -t 2 ]]; then
	interactive=true
fi

no_steps='{"version":1,"hook":null,"steps":[]}'

# The host's switch steps (modules/switch/README.md). Anything wrong with them only warns: the switch
# itself never depends on a step.
function read_plan() {
	local errors version
	errors=$(mktemp "${TMPDIR:-/tmp}/switch-plan.XXXXXX")
	if ! plan=$(nix eval --json "${override[@]}" ".#$host_attr.config.switch.plan" 2>"$errors"); then
		echo "warning: could not read switch.plan for $config_name; running without switch steps" >&2
		# Nix may print a bare `error:` before the trace; the message is the first one with text.
		awk '/^[[:space:]]*error: *[^[:space:]]/ { sub(/^[[:space:]]+/, ""); print; exit }' "$errors" >&2
		plan=$no_steps
	fi
	rm -f "$errors"

	version=$(printf '%s' "$plan" | jq -r '.version // "none"' 2>/dev/null) || version=none
	if [[ $version != 1 ]]; then
		echo "warning: the switch steps of $config_name use format $version, but this switch reads format 1;" \
			"update the dotfiles input or run with --local. Running without switch steps." >&2
		plan=$no_steps
	elif ! printf '%s' "$plan" | jq -e '(.hook | type == "string" or type == "null") and (.steps | type == "array")
		and all(.steps[]; (.name, .phase, .exe | type == "string") and (.secrets | type == "object"))' >/dev/null 2>&1; then
		echo "warning: the switch steps of $config_name are not a valid plan; running without them" >&2
		plan=$no_steps
	fi

	if [[ $(printf '%s' "$plan" | jq '.steps | length') == 0 ]]; then
		return 0
	fi
	if ! nix build --no-link "${override[@]}" ".#$host_attr.config.switch.tools"; then
		echo "warning: could not build the switch steps of $config_name; running without them" >&2
		plan=$no_steps
	fi
}

# The hook's answer, never exported: unset drops the export mark of a `secrets` from the environment.
# Values leave it only through pipes: bash 3.2 backs here-strings with temp files.
unset secrets
secrets='{}'

# Asks the hook once for every step's secrets, labelled `<step>.<label>`.
function read_secrets() {
	local hook request
	hook=$(printf '%s' "$plan" | jq -r '.hook // empty')
	[[ -n "$hook" ]] || return 0
	request=$(printf '%s' "$plan" | jq -c --argjson interactive "$interactive" '{
		version: 1,
		purpose: "switch",
		interactive: $interactive,
		refs: (reduce .steps[] as $step ({}; . + ($step.secrets | with_entries(.key = "\($step.name).\(.key)"))))
	}')
	if ! secrets=$(printf '%s' "$request" | "$hook") ||
		! printf '%s' "$secrets" | jq -e 'type == "object"' >/dev/null 2>&1; then
		echo "warning: the secrets hook failed; switch steps run without their secrets" >&2
		secrets='{}'
	fi
}

# run_steps <phase> <system store path, or empty>: runs that phase's steps in plan order.
function run_steps() {
	local steps count i step name exe base rc
	steps=$(printf '%s' "$plan" | jq -c --arg phase "$1" '[.steps[] | select(.phase == $phase)]')
	count=$(printf '%s' "$steps" | jq length)
	for ((i = 0; i < count; i++)); do
		step=$(printf '%s' "$steps" | jq -c --argjson i "$i" '.[$i]')
		name=$(printf '%s' "$step" | jq -r .name)
		exe=$(printf '%s' "$step" | jq -r .exe)
		base=$(printf '%s' "$step" | jq -c --arg host "$config_name" --argjson interactive "$interactive" --arg system "$2" '{
			version: 1,
			step: .name,
			host: $host,
			phase,
			interactive: $interactive,
			system: (if $system == "" then null else $system end),
			settings
		}')
		echo ""
		echo "=== $name ==="
		rc=0
		printf '%s' "$secrets" |
			jq -c --arg prefix "$name." --argjson base "$base" \
				'$base + {secrets: with_entries(select(.key | startswith($prefix)) | .key |= ltrimstr($prefix))}' |
			"$exe" || rc=$?
		if [[ $rc != 0 ]]; then
			echo "warning: switch step $name failed (exit $rc); carrying on" >&2
		fi
	done
}

read_plan
read_secrets
run_steps preBuild ""

build "$host_attr.system" "${override[@]}"
if [[ $kind == darwin ]]; then
	sudo ./result/sw/bin/darwin-rebuild switch \
		--show-trace \
		"${override[@]}" \
		--flake ".#$config_name" "$@"
else
	sudo nixos-rebuild switch \
		--show-trace \
		"${override[@]}" \
		--flake ".#$config_name" "$@"
fi

echo ""
echo "=== Package changes ==="
if current=$(readlink /nix/var/nix/profiles/system | grep -o '[0-9]*'); then
	previous=$((current - 1))
	nix store diff-closures "/nix/var/nix/profiles/system-${previous}-link" "/nix/var/nix/profiles/system-${current}-link" 2>/dev/null || true
fi

run_steps postSwitch "$(readlink result)"
secrets=
