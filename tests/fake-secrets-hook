#!/bin/bash -e

# The smallest secrets hook (modules/secrets/README.md): ./fake-secrets.json instead of a password
# manager. When FAKE_HOOK_LOG is set, each request is appended to it so tests can check what was sent.
request=$(cat)
if [[ -n "${FAKE_HOOK_LOG:-}" ]]; then
	printf '%s\n' "$request" >>"$FAKE_HOOK_LOG"
fi
printf '%s' "$request" | jq -e '.version == 1' >/dev/null
printf '%s' "$request" |
	jq -c --slurpfile table "$(dirname "$0")/fake-secrets.json" '.refs | map_values($table[0][tostring] // empty)'
